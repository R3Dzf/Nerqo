<Application x:Class="Nerqo.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Background" Color="#101B2C" />
    <SolidColorBrush x:Key="Panel" Color="#1D2C41" />
    <SolidColorBrush x:Key="Foreground" Color="#F2F8FC" />
    <SolidColorBrush x:Key="Muted" Color="#B6C9D9" />
    <SolidColorBrush x:Key="Accent" Color="#A6ECD9" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Foreground}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#0D342D"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#243951"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#506780"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/></Style>
  </Application.Resources>
</Application>
