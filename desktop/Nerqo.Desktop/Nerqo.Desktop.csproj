<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nerqo</AssemblyName>
    <Version>1.0.7</Version>
    <ApplicationIcon>nerqo.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" /><PackageReference Include="QRCoder" Version="1.6.0" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/nerqo.png" /><Resource Include="nerqo.ico" /></ItemGroup>
</Project>
