<Window x:Class="Nerqo.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nerqo" Icon="nerqo.ico" Height="800" Width="1220" MinHeight="640" MinWidth="960" WindowStartupLocation="CenterScreen" Background="{DynamicResource Background}" FontFamily="Segoe UI" UseLayoutRounding="True" AllowDrop="True" DragOver="WindowDragOver" Drop="WindowDrop">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#123D43"><DockPanel Margin="20,28,20,22" LastChildFill="True">
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="4,0,0,34"><Image Source="Assets/nerqo.png" Width="42" Height="42"/><TextBlock Text="Nerqo" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="10,2,0,0"/></StackPanel>
    <TextBlock Text="WORKSPACE" Foreground="#8EB5B3" FontSize="10" FontWeight="Bold" Margin="18,0,0,12"/>
    <RadioButton x:Name="TransferNav" GroupName="Navigation" Tag="Transfers" Style="{StaticResource Navigation}" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,13,0"/><TextBlock Text="Transfers" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
    <RadioButton x:Name="DevicesNav" GroupName="Navigation" Tag="Devices" Style="{StaticResource Navigation}" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,13,0"/><TextBlock Text="Devices" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Tag="Settings" Style="{StaticResource Navigation}" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,13,0"/><TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Background="#1D4B50" CornerRadius="14" Padding="16" Margin="0,0,0,20"><StackPanel><TextBlock Text="Your devices. Your files." Foreground="#C1F5DF" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Shared over your local network." Foreground="#A3C1BE" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="Nerqo 1.0.2" Foreground="#8EB5B3" FontSize="11" Margin="12,0,0,0"/></StackPanel>
   <Grid/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="32,26,32,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Transfers" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="A little closer. A lot easier to share." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource Surface}" CornerRadius="18" Padding="14,9"><TextBlock x:Name="StatusLabel" Text="Starting receiver…" Foreground="{DynamicResource Accent}" FontSize="12"/></Border></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,10,0">
     <StackPanel x:Name="TransfersPage">
      <Border Background="#16494D" CornerRadius="22" Padding="26" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="From here to there." Foreground="#F2FFFA" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Files, folders and ideas. Straight to your phone." Foreground="#B8D7D0" Margin="0,8,0,20" TextWrapping="Wrap"/><TextBlock x:Name="TransferHint" Text="Pair your phone from Devices to get started." Foreground="#B5F5DA" FontSize="12" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Connect a device" Click="GoToDevices" VerticalAlignment="Bottom" Background="#B5F5DA" Foreground="#123D43" Margin="18,0,0,0"/></Grid></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <StackPanel>
        <Border x:Name="DropZone" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Send something" FontSize="19" FontWeight="SemiBold"/><Border Background="{DynamicResource Surface}" CornerRadius="14" Margin="0,16,0,16" Padding="18,22"><StackPanel><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Drop files or folders here" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6"/><TextBlock Text="Or choose what you'd like to share" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel></Border><Button x:Name="ShareFilesButton" Content="Choose files" Click="ShareFile"/><Button x:Name="ShareFolderButton" Content="Choose folder" Click="ShareFolder" Style="{StaticResource Secondary}" Margin="0,9,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="A note, a link, anything." FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="NoteInput" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,16,0,12" AutomationProperties.Name="Text or link to share"/><Button Content="Send text or link" Click="ShareNote"/><TextBlock Text="Clipboard stays private. Paste only what you want to send." Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
       </StackPanel>
       <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><Grid><TextBlock Text="Activity" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ItemCountLabel" Text="0 items" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></Grid><TextBlock Text="Shared files stay available to your paired devices." Style="{StaticResource Caption}" Margin="0,8,0,14"/><Button Content="Open received folder" Click="OpenReceived" Style="{StaticResource Secondary}"/><TextBlock x:Name="EmptyItemsLabel" Text="Nothing shared yet.&#x0a;Your files and notes will appear here." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,36,0,26"/>
        <ListBox x:Name="ItemList" MaxHeight="460" Margin="0,14,0,0" MouseDoubleClick="OpenTransfer" AutomationProperties.Name="Shared items">
         <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="32" Height="36" CornerRadius="8" Background="{DynamicResource Surface}" VerticalAlignment="Top"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox><Button Content="Copy selected item" Click="CopySelectedItem" Style="{StaticResource Secondary}" Margin="0,12,0,0"/></StackPanel></Border>
      </Grid>
     </StackPanel>
     <StackPanel x:Name="DevicesPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Border Background="White" CornerRadius="16" Padding="12" HorizontalAlignment="Left"><Image x:Name="PairQrImage" Width="205" Height="205" Stretch="Uniform" AutomationProperties.Name="Pairing QR code"/></Border><TextBlock Text="Scan in Nerqo on Android" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="20,2,0,0"><TextBlock Text="Meet your phone." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="1. Join the same Wi-Fi or phone hotspot.&#x0a;2. Open Devices on Android.&#x0a;3. Scan this QR to pair securely." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="25" Margin="0,12,0,18"/><TextBlock Text="PAIRING CODE" Style="{StaticResource Caption}"/><TextBlock x:Name="PairCodeLabel" Text="------" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,4,0,12"/><Button Content="Copy pairing code" Click="CopyPairCode" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Your local connection" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="BandLabel" Text="Checking Wi-Fi…" Foreground="{DynamicResource Accent}" Margin="0,14,0,8" TextWrapping="Wrap"/><TextBlock x:Name="AddressLabel" Style="{StaticResource Caption}"/><TextBlock Text="Prefer 5 GHz or 6 GHz when both devices support it. Choose the band in your router or hotspot settings." Style="{StaticResource Caption}" Margin="0,12,0,14"/><Button Content="Refresh network and QR" Click="RefreshNetworkAndQr" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Trusted devices" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="EmptyPeersLabel" Text="No paired devices yet. Scan the QR above to add your phone." Style="{StaticResource Caption}" Margin="0,12,0,0"/><ListBox x:Name="PeerList" DisplayMemberPath="Name" MaxHeight="140" Margin="0,14,0,12" AutomationProperties.Name="Trusted devices"/><Button Content="Remove selected device" Click="RevokeSelectedPeer" Style="{StaticResource Secondary}" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Make yourself at home." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,22,0,8"/><CheckBox x:Name="DarkModeToggle" Content="Dark appearance" Foreground="{DynamicResource Foreground}" FontSize="14" Checked="ChangeTheme" Unchecked="ChangeTheme" Padding="8"/><TextBlock Text="Nerqo stays in the system tray when you close the window. Use Exit Nerqo in the tray menu to stop receiving." Style="{StaticResource Caption}" Margin="0,18,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Security identity" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Compare this identity with your phone when pairing manually." Style="{StaticResource Caption}" Margin="0,10,0,10"/><TextBlock x:Name="IdentityLabel" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Only paired devices can access your shares. Revoke access from Devices." Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Keep Nerqo up to date" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Updates use the internet. Local transfers work offline." Style="{StaticResource Caption}" Margin="0,10,0,16"/><Button x:Name="CheckUpdatesButton" Content="Check for app updates" Click="CheckForUpdates" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,16,0,0"><ProgressBar x:Name="OperationProgress" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Stroke}" Visibility="Collapsed" Margin="0,0,0,10"/><TextBlock x:Name="FooterLabel" Text="Local sharing, ready when you are." Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel>
  </Grid>
 </Grid>
</Window>
